{
	"layer": "top",
	"position": "top",
	"reload_style_on_change": true,
	"mod": "dock",
	"exclusive": true,
	"passthrough": false,
	"gtk-layer-shell": true,
	"spacing": 6,
	"margin-top": 3,
	"margin-left": 3,
	"margin-right": 3,
	"modules-left": [
		"hyprland/workspaces",
		"custom/media",
		"hyprland/window"
	],
	"modules-center": [
		"clock"
	],
	"modules-right": [
		"idle_inhibitor",
		"cpu",
		"memory",
		"temperature",
		"tray",
		"network",
		"bluetooth",
		"battery",
		"backlight",
		"pulseaudio",
		"pulseaudio#microphone",
		"privacy",
		"custom/power"
	],
	"hyprland/workspaces": {
		"disable-scroll": true,
		"format": "{icon}",
		"format-icons": {
			"1": "",
			"2": "",
			"3": "",
			"4": "",
			"5": "",
			// "active": "",
			"default": ""
		},
		"persistent-workspaces": {
			"*": 1,
			"*": 2,
			"*": 3
		}
	},
	"clock": {
		"interval": 1,
		"format": " {:%d/%m/%y  %I:%M %p}",
		"format-alt": " {:L%a, %B %d, %Y  %I:%M %p}",
		"timezone": "Asia/Calcutta",
		"tooltip-format": "{calendar}",
		"calendar": {
			"mode": "month",
			"mode-mon-col": 3,
			"on-scroll": 1,
			"format": {
				"months": "<span color='#ffead3'><b>{}</b></span>",
				"days": "<span color='#ecc6d9'><b>{}</b></span>",
				"weekdays": "<span color='#ffcc66'><b>{}</b></span>",
				"today": "<span color='#ff6699'><b><u>{}</u></b></span>"
			}
		},
		"actions": {
			"on-click-right": "mode",
			"on-click-forward": "tz_up",
			"on-click-backward": "tz_down",
			"on-scroll-up": "shift_up",
			"on-scroll-down": "shift_down"
		}
	},
	"hyprland/window": {
		"max-length": 90,
		"separate-outputs": true
	},
	"idle_inhibitor": {
		"format": "{icon}",
		"format-icons": {
			"activated": " ",
			"deactivated": " "
		}
	},
	"network": {
		"format": "{ifname}",
		"format-wifi": "  {essid}",
		"format-ethernet": "󰈀 {ipaddr}/{cidr}",
		"format-disconnected": "",
		"tooltip-format": "{ifname} via {gwaddr} 󰈀\n{bandwidthUpBits} 󰳘\n{bandwidthDownBits} 󰱦",
		"tooltip-format-wifi": "{essid} ({signalStrength}%) {ifname} {icon}\n{bandwidthUpBits} 󰳘 \n{bandwidthDownBits} 󰱦 \n{ipaddr} via {gwaddr}",
		"tooltip-format-ethernet": "{ipaddr}/{cidr} {ifname} 󰈀\n{bandwidthUpBits} 󰳘\n{bandwidthDownBits} 󰱦",
		"tooltip-format-disconnected": "Disconnected",
		"max-length": 10
	},
	"bluetooth": {
		"format": "",
		"format-disabled": "",
		"format-connected": "",
		"format-connected-battery": " {device_alias} {device_battery_percentage}%",
		"tooltip-format-connected": " {device_alias}",
		"tooltip-format-connected-battery": " {device_alias} {device_battery_percentage}%",
		"max-length": 10
	},
	"pulseaudio": {
		"format": "{icon} {volume}%",
		"format-muted": "  ",
		"on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
		"reverse-scrolling": true,
		"on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 1%+",
		"on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%-",
		"format-icons": {
			"headphone": "",
			"hands-free": "",
			"headset": "",
			"phone": "",
			"portable": "",
			"car": "",
			"default": [
				"",
				"",
				" "
			]
		}
	},
	"pulseaudio#microphone": {
		"format": "{format_source}",
		"format-source": " {volume}%",
		"format-source-muted": " ",
		"reverse-scrolling": true,
		"on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
		"on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SOURCE@ 1%+",
		"on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 1%-"
	},
	"tray": {
		"icon-size": 10,
		"spacing": 6
	},
	"battery": {
		"format": "{icon} {capacity}%",
		"format-icons": {
			"charging": [
				"󰢜",
				"󰂆",
				"󰂇",
				"󰂈",
				"󰢝",
				"󰂉",
				"󰢞",
				"󰂊",
				"󰂋",
				"󰂅"
			],
			"default": [
				"󰁺",
				"󰁻",
				"󰁼",
				"󰁽",
				"󰁾",
				"󰁿",
				"󰂀",
				"󰂁",
				"󰂂",
				"󰁹"
			]
		},
		"interval": 30,
		"states": {
			"warning": 30,
			"critical": 20
		}
	},
	"backlight": {
		"device": "intel_backlight",
		"format": "{icon} {percent}%",
		"format-icons": [
			"",
			"",
			"",
			"",
			"",
			"",
			"",
			"",
			""
		],
		"reverse-scrolling": true,
		"on-scroll-up": "brightnessctl s 1%+",
		"on-scroll-down": "brightnessctl s 1%- --min-value=4800"
	},
	"cpu": {
		"interval": 10,
		"format": "󰍛 {usage}%",
	},
	"memory": {
		"interval": 10,
		"format": " {used:0.1f}G"
	},
	"temperature": {
		// "thermal-zone": 2,
		// "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
		"critical-threshold": 80,
		// "format-critical": "{temperatureC}°C {icon}",
		"format": "{icon} {temperatureC}°C",
		"format-icons": [
			"",
			"",
			""
		],
		"tooltip": false
	},
	"custom/power": {
		"format": "",
		"tooltip": false,
		// "on-click": "powermenu"
		"menu": "on-click",
		"menu-file": "$HOME/.config/waybar/power_menu.xml",
		"menu-actions": {
			"Poweroff": "powermenu Poweroff",
			"Reboot": "powermenu Reboot",
			"Suspend": "powermenu Suspend",
			"Hibernate": "powermenu Hibernate",
			"Lock": "powermenu Lock"
		}
	},
	"custom/media": {
		"format": "{icon} {text}",
		"return-type": "json",
		"max-length": 40,
		"escape": true,
		"exec": "$HOME/.config/waybar/mediaplayer.py 2> /dev/null",
		"menu": "on-click",
		"menu-file": "$HOME/.config/waybar/mediaplayer.xml",
		"menu-actions": {
			"play/pause": "mpvctl play/pause",
			"next": "mpvctl next",
			"prev": "mpvctl prev"
		}
	},
	"privacy": {
		"icon-size": 10,
		"spacing": 6,
		"modules": [
			{
				"type": "audio-in"
			},
			{
				"type": "screenshare"
			}
		]
	}
}
